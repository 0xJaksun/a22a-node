{
  "name": "@a22a/sdk",
  "version": "0.1.0",
  "description": "Node.js SDK for a22a, the hosted runner for multi-step LLM workflows.",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xJaksun/a22a-node.git"
  },
  "homepage": "https://a22a.sh",
  "bugs": "https://github.com/0xJaksun/a22a-node/issues",
  "keywords": [
    "a22a",
    "llm",
    "ai",
    "workflow",
    "workflows",
    "serverless",
    "prompt chain",
    "agents",
    "orchestration",
    "openai",
    "anthropic",
    "sdk"
  ],
  "packageManager": "pnpm@11.5.3",
  "engines": {
    "node": ">=20.19"
  },
  "exports": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "a22a": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/bin.ts --format esm --dts --clean",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@types/node": "^24",
    "tsup": "^8",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
